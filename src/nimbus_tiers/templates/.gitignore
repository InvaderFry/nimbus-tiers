# Per-feature artifacts — generated each task by Phase 1, archived to plans/ on completion.
PLAN.md
TESTS.md

# Aider working files.
# Use the broad `.aider*` glob, not the individual files: on startup Aider adds
# `.aider*` to .gitignore if it is not already present ("Added .aider* to
# .gitignore"). That auto-edit modifies a tracked file, which makes the working
# tree dirty and silently defeats phase2.sh's "Aider made no changes" guard —
# a total executor failure (zero real edits) then sails through to verify.sh and
# can be committed as DONE. Listing `.aider*` here removes Aider's reason to touch
# the file at all.
# The negations below re-include the two committed config files: `.aider*` also
# matches `.aider.conf.yml` and `.aiderignore`, which the generator writes into
# every project and stages with `git add .` — without these `!` lines the glob
# would silently drop both from the scaffold commit, shipping projects with no
# tracked Aider config. The literal `.aider*` line is still present, so Aider has
# no reason to rewrite .gitignore; only the transient caches/history stay ignored.
.aider*
!.aider.conf.yml
!.aiderignore

# Phase 2 aider run logs — transient, not for version control
plans/*.log

# Local secrets — must never be committed.
.env
.env.*
secrets/
**/credentials.*
**/api_keys.*

# Common Python artifacts (delete this block if your project isn't Python).
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/
build/
*.egg-info/

# Common JS artifacts (delete this block if your project isn't JS).
node_modules/
.next/
.turbo/

# Common Java artifacts (delete this block if your project isn't Java/Maven or Java/Gradle).
target/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
